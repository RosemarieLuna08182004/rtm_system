# Copy to .env.development.local to point the app at a backend running on your PC.
# Use your PC's Wi-Fi IP address (run `ipconfig`), not "localhost" — the phone is a different device.
# Expo only reads .env.development.local for `npx expo start`; release builds always use production.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
