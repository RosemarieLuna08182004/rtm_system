{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "ANDROID_TARGET_SDK_VERSION": "35",
        "ANDROID_COMPILE_SDK_VERSION": "35"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
