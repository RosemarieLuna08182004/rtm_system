<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS settings for the marketing site on SmarterASP.NET (Windows hosting). -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- The host otherwise sends "cache for a year" with every file, so edits to the page,
           styles.css or script.js wouldn't reach visitors. Re-check them on every visit. -->
      <clientCache cacheControlMode="DisableCache" />
      <!-- Older IIS versions don't know .webp, so the illustrations would not load without this. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <!-- The host adds "Cache-Control: max-age=31536000" at server level, above <clientCache>.
         Replace it for the page, styles and script (pictures keep their week-long cache). -->
    <rewrite>
      <outboundRules>
        <rule name="Re-check pages, styles and scripts" preCondition="IsPageOrCode">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <preConditions>
          <preCondition name="IsPageOrCode">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^(text/html|text/css|application/javascript)" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
  <!-- Pictures rarely change, so browsers may keep them for a week; the page itself is always re-checked. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
