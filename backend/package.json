{
  "name": "backend",
  "version": "1.0.0",
  "description": "Typescript Express",
  "main": "src/index.ts",
  "scripts": {
    "build:dev": "rimraf build && npx tsc && npx copyfiles ca.pem build",
    "build:production": "npx tsc && npx copyfiles ca.pem build",
    "prestart": "npm run build:production",
    "start": "node build/index.js",
    "preserve": "npm run build:production",
    "serve": "concurrently \"npx tsc -w\" \"nodemon build/index.js\"",
    "test": "jest --config jest.config.ts --coverage --maxWorkers=1 --detectOpenHandles",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix"
  },
  "author": "EmperorKira",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@types/bcrypt": "^5.0.2",
    "@types/google-cloud__storage": "^2.3.1",
    "bcrypt": "^5.1.1",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.10.3",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "stripe": "^17.4.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
