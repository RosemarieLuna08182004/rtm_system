{
    "compilerOptions": {
        "target": "ES2020",
        "module": "node16",
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "outDir": "build",
        "forceConsistentCasingInFileNames": true,
        "strict": false,
        "skipLibCheck": true,
        "types": ["node", "jest", "reflect-metadata"],
        // node16 replaces the deprecated "node"; output is still CommonJS (package.json has no "type": "module")
        "moduleResolution": "node16",
        "sourceMap": true,
        "resolveJsonModule": true,
        "rootDir": "src",
    },
    // Tests are included so the editor and Jest type-check them; the build uses tsconfig.build.json, which leaves them out
    "exclude": ["node_modules", "build"],
    "include": ["src/**/*.ts"]
}